{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "start_hidden": true,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "network",
    "hyprland/language",
    "battery",
    "clock",
    "tray"
    //"custom/hyprwhspr"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "active-only": false
  },
  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true
  },
  "clock": {
    "interval": 1,
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B %d}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "  disconnected",
    "tooltip-format": "{ipaddr} via {gwaddr}",
    "max-length": 20,
    "on-click": "alacritty --title 'nmtui' --class '__floating_nmtui' -e nmtui"
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 1
  },
  //"hyprland/language": {
  //  "format": "  {lang}",
  //  //"on-click": "alacritty --title 'setxkbmap' --class '__floating_setxkbmap' -e setxkbmap -layout us,ro,ru -variant ,std,phonetic -option grp:caps_toggle"
  //},
  "hyprland/language": {
    "format": "{}",
    "format-en": "US",
    "format-ro": "RO",
    "format-ru": "RU"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "tray": {
    "spacing": 8,
    "icon-size": 14
  },
  //"include": [
  //  "/home/vlad/.config/waybar/hyprwhspr-module.jsonc"
  //]
}