#!/usr/bin/bash

# Ensure the script is run as root
if [ "$EUID" -ne 0 ]; then
  echo "Error: Please run this script as root (e.g., sudo ./mount_windows.sh)"
  exit 1
fi

TARGET_MOUNT="/mnt/c"
TARGET_PART=""
PREV_TYPE=""
PREV_DISK=""

# Create the mount point if it doesn't exist
mkdir -p "$TARGET_MOUNT"

# Read block device info: Parent Disk (PKNAME), Partition Path (PATH), and Partition Type (PARTTYPENAME)
# We use process substitution to feed lsblk output into the while loop

# Microsoft reserved then Microsoft basic data
while read -r current_disk part_path part_type; do
    
    # Check our heuristic:
    # 1. Current partition is "Microsoft basic data"
    # 2. Previous partition was "Microsoft reserved"
    # 3. Both partitions share the same parent disk
    if [[ "$part_type" == "Microsoft basic data" && \
          "$PREV_TYPE" == "Microsoft reserved" && \
          "$current_disk" == "$PREV_DISK" ]]; then
          
        TARGET_PART="$part_path"
        break
    fi
    
    # Store current values for the next iteration's check
    PREV_DISK="$current_disk"
    PREV_TYPE="$part_type"

done < <(lsblk -n -l -p -o PKNAME,PATH,PARTTYPENAME)

# Mount the partition if found
if [ -n "$TARGET_PART" ]; then
    echo "Heuristic match found! Windows partition is at: $TARGET_PART"
    
    # Attempt to mount read-write, fall back to read-only if Windows is hibernated
    MOUNT_OPTS="uid=1000,gid=1000,dmask=0022,fmask=0133"
    if mount -t ntfs-3g -o "$MOUNT_OPTS" "$TARGET_PART" "$TARGET_MOUNT" 2>/dev/null; then
        echo "Success: Mounted $TARGET_PART to $TARGET_MOUNT (read-write)"
    elif mount -t ntfs-3g -o "ro,$MOUNT_OPTS" "$TARGET_PART" "$TARGET_MOUNT"; then
        echo "Warning: Mounted $TARGET_PART to $TARGET_MOUNT READ-ONLY"
        echo "         Windows Fast Startup is likely enabled. Disable it or do a full Shift+Shutdown."
    else
        echo "Error: Failed to mount $TARGET_PART entirely."
        echo "Possible fix: ntfsfix -d /dev/nvme0n1p3"
        exit 2
    fi
else
    echo "Error: Could not find a 'Microsoft basic data' partition immediately preceded by a 'Microsoft reserved' partition."
    exit 1
fi
